{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
  {{- $content := .Plain -}}
  {{- if .Params.password -}}
    {{- $content = "" -}}
  {{- end -}}
  {{- $.Scratch.Add "index" (dict "title" .Title "content" $content "permalink" .Permalink) -}}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
